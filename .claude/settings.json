{
  "permissions": {
    "allow": ["Bash(npm test:*)", "Bash(npm run lint:*)"],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.env.test)",
      "Bash(cat .env)",
      "Bash(cat .env.local)",
      "Bash(cat .env.*.local)",
      "Bash(cat .env.development)",
      "Bash(cat .env.production)",
      "Bash(cat .env.test)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ],
    "ask": ["Bash(git push:*)"]
  }
}
