{
  "permissions": {
    "allow": [
      "Bash(npm test:*)",
      "Bash(npm run lint:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(cp)",
      "Bush(rm)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(git push -f:*)",
      "Bash(git push --force:*)"
    ]
  }
}
