{
  "permissions": {
    "allow": [
      "Bash(npm test:*)",
      "Bash(npm run lint:*)",
      "PowerShell(npm test *)",
      "PowerShell(npm run lint *)"
    ],
    "ask": [
      "Bash(git push:*)",
      "PowerShell(git push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(git push --force:*)",
      "PowerShell(git push --force *)"
    ]
  }
}
