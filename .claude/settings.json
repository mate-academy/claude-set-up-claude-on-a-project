{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run dev)",
      "Bash(npm test)",
      "Bash(npm run lint)",
      "PowerShell(npm run dev)",
      "PowerShell(npm test)",
      "PowerShell(npm run lint)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(git push --force:*)",
      "PowerShell(git push --force:*)"
    ]
  }
}
