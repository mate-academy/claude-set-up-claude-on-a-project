{
  "permissions": {
    "allow": [
      "Bash(npm test:*)",
      "Bash(npm run lint:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "PowerShell(npm test:*)",
      "PowerShell(npm run lint:*)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "PowerShell(git push:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(git push --force:*)",
      "PowerShell(git push --force:*)",
      "Bash(rm -rf:*)"
    ]
  }
}
