{
  "permissions": {
    "allow": [
      "Bash(npm run dev)",
      "Bash(npm run lint)",
      "Bash(npm test)",
      "Bash(node --test:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "PowerShell(npm run dev)",
      "PowerShell(npm run lint)",
      "PowerShell(npm test)",
      "PowerShell(node --test:*)",
      "PowerShell(git status)",
      "PowerShell(git diff:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "PowerShell(git push:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(rm -rf:*)",
      "PowerShell(rm -rf:*)",
      "PowerShell(Remove-Item -Recurse:*)"
    ]
  }
}
