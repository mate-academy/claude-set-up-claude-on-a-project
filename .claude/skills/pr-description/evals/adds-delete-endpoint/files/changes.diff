+// DELETE /users/:id — remove a user, or 404 if it doesn't exist
+router.delete("/:id", (req, res) => {
+  const id = Number(req.params.id);
+
+  if (!store.deleteUser(id)) {
+    return res.status(404).json({ error: "User not found" });
+  }
+
+  res.status(204).end();
+});
+
 module.exports = router;
