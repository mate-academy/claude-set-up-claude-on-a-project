{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true
  },
  "include": ["server.ts", "routes/**/*.ts", "db/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
