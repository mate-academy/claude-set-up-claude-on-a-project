# Sample configuration. Copy this file to `.env` and fill in real values.
# `.env` is git-ignored, so your real secrets never get committed.

PORT=3000

# Name reported by GET /health and in the startup log (defaults to "users-api")
API_NAME=users-api

# Example of where a real secret would go (not used by the starter app):
# DATABASE_URL=postgres://user:password@localhost:5432/app
