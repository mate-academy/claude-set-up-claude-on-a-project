{
  "permissions": {
    "allow": [
      "Bash(npm run dev)",
      "Bash(npm test)",
      "Bash(npm test:*)",
      "Bash(npm run lint)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Read(**)"
    ],
    "ask": [
      "Bash(npm install:*)",
      "Bash(npm run build)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Edit(package.json)",
      "Edit(package-lock.json)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Bash(rm -rf:*)",
      "Bash(*curl*)",
      "Bash(*sudo*)",
      "Bash(git push --force:*)"
    ]
  }
}
